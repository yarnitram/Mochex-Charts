# Mochex Environment Configuration

# PocketBase Backend URL
# In Docker compose, mochex connects to pocketbase service: http://pocketbase:8090
# In local development: http://127.0.0.1:8090
POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# JWT secret for signing session cookies
JWT_SECRET=mochex-super-secret-jwt-key-2026-production-min32chars
